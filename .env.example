# --- IA de texto (al menos una requerida) ---
# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Gemini (Google) - tambien genera las imagenes para redes sociales
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Supabase (cuentas y guardado en la nube) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (pagos y suscripciones) ---
# Obtén estas keys en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Obtén este en https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# ID del precio Pro (crea en https://dashboard.stripe.com/products) — debe tener NEXT_PUBLIC_ para acceso cliente
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
